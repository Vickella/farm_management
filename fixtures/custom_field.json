[
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Management",
    "fieldname": "section_break_agriculture_details",
    "fieldtype": "Section Break",
    "label": "Agriculture Details",
    "insert_after": "project_name",
    "depends_on": ""
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Management",
    "fieldname": "agriculture_project_type",
    "fieldtype": "Link",
    "label": "Agriculture Project Type",
    "insert_after": "section_break_agriculture_details",
    "options": "Agriculture Project Type"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Management",
    "fieldname": "agriculture_farm_type",
    "fieldtype": "Link",
    "label": "Farm Type",
    "insert_after": "agriculture_project_type",
    "options": "Farm Type",
    "read_only": 1,
    "fetch_from": "agriculture_project_type.farm_type",
    "depends_on": "eval:doc.agriculture_project_type"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Management",
    "fieldname": "managed_item_doctype",
    "fieldtype": "Link",
    "label": "Managed Produce Type",
    "insert_after": "agriculture_farm_type",
    "options": "DocType",
    "read_only": 1,
    "hidden": 1,
    "depends_on": "eval:doc.agriculture_project_type"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Management",
    "fieldname": "managed_crop_animal_species",
    "fieldtype": "Dynamic Link",
    "label": "Managed Crop / Animal / Species",
    "insert_after": "managed_item_doctype",
    "options": "managed_item_doctype",
    "mandatory_depends_on": "eval:doc.agriculture_project_type",
    "depends_on": "eval:doc.agriculture_project_type"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Management",
    "fieldname": "expected_output_item",
    "fieldtype": "Link",
    "label": "Expected Output Item",
    "description": "Stock Item expected from this farm project. Configured from the selected Project Type and farm produce.",
    "insert_after": "managed_crop_animal_species",
    "options": "Item",
    "read_only": 1,
    "depends_on": "eval:doc.agriculture_project_type"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Management",
    "fieldname": "animal_breed",
    "fieldtype": "Link",
    "label": "Breed",
    "insert_after": "expected_output_item",
    "options": "Livestock Breed",
    "depends_on": "eval:doc.managed_item_doctype == 'Livestock Species'"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Management",
    "fieldname": "project_quantity",
    "fieldtype": "Float",
    "label": "Planned Area / Capacity",
    "description": "Planning scale only: hectares for crops and planned head or birds for livestock. Actual livestock quantities are recognized through Animal Stock Entry.",
    "insert_after": "animal_breed",
    "mandatory_depends_on": "eval:doc.agriculture_project_type",
    "depends_on": "eval:doc.agriculture_project_type"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Management",
    "fieldname": "project_unit",
    "fieldtype": "Link",
    "label": "Planning UOM",
    "insert_after": "project_quantity",
    "options": "UOM",
    "mandatory_depends_on": "eval:doc.agriculture_project_type",
    "depends_on": "eval:doc.agriculture_project_type"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Management",
    "fieldname": "initial_asset_cost",
    "fieldtype": "Currency",
    "label": "Opening Biological Asset Value",
    "description": "Optional. Use only for animals already owned at project opening. For new purchases, leave zero and let the submitted Animal Stock Entry use the Purchase Invoice cost.",
    "insert_after": "project_unit",
    "mandatory_depends_on": "",
    "depends_on": "eval:doc.agriculture_project_type && !['Crop Production', 'Horticulture', 'Agroforestry'].includes(doc.agriculture_farm_type)"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Management",
    "fieldname": "farm",
    "fieldtype": "Link",
    "label": "Farm",
    "insert_after": "initial_asset_cost",
    "options": "Farm",
    "mandatory_depends_on": "eval:doc.agriculture_project_type",
    "depends_on": "eval:doc.agriculture_project_type"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Management",
    "fieldname": "biological_asset",
    "fieldtype": "Link",
    "label": "Biological Asset",
    "insert_after": "farm",
    "options": "Biological Asset",
    "read_only": 1,
    "depends_on": "eval:doc.agriculture_project_type"
  }
]
