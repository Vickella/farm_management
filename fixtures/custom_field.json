[
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Setup",
    "fieldname": "section_break_agriculture_details",
    "fieldtype": "Section Break",
    "label": "Agriculture Details",
    "insert_after": "project_name",
    "depends_on": ""
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Setup",
    "fieldname": "agriculture_project_type",
    "fieldtype": "Link",
    "label": "Agriculture Project Type",
    "insert_after": "section_break_agriculture_details",
    "options": "Agriculture Project Type"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Setup",
    "fieldname": "agriculture_farm_type",
    "fieldtype": "Link",
    "label": "Farm Type",
    "insert_after": "agriculture_project_type",
    "options": "Farm Type",
    "read_only": 1,
    "fetch_from": "agriculture_project_type.farm_type",
    "depends_on": "eval:doc.agriculture_project_type"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Setup",
    "fieldname": "managed_item_doctype",
    "fieldtype": "Link",
    "label": "Managed Produce Type",
    "insert_after": "agriculture_farm_type",
    "options": "DocType",
    "read_only": 1,
    "hidden": 1,
    "depends_on": "eval:doc.agriculture_project_type"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Setup",
    "fieldname": "managed_crop_animal_species",
    "fieldtype": "Dynamic Link",
    "label": "Managed Crop / Animal / Species",
    "insert_after": "managed_item_doctype",
    "options": "managed_item_doctype",
    "mandatory_depends_on": "eval:doc.agriculture_project_type",
    "depends_on": "eval:doc.agriculture_project_type"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Setup",
    "fieldname": "expected_output_item",
    "fieldtype": "Link",
    "label": "Expected Output Item",
    "description": "Stock Item expected from this farm project. Configured from the selected Project Type and farm produce.",
    "insert_after": "managed_crop_animal_species",
    "options": "Item",
    "read_only": 1,
    "depends_on": "eval:doc.agriculture_project_type"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Setup",
    "fieldname": "animal_breed",
    "fieldtype": "Link",
    "label": "Breed",
    "insert_after": "expected_output_item",
    "options": "Livestock Breed",
    "depends_on": "eval:doc.managed_item_doctype == 'Livestock Species'"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Setup",
    "fieldname": "project_quantity",
    "fieldtype": "Float",
    "label": "Planned Area / Capacity",
    "description": "Planning scale only: hectares for crops and planned head or birds for livestock. Actual livestock quantities are recognized through Animal Stock Entry.",
    "insert_after": "animal_breed",
    "mandatory_depends_on": "eval:doc.agriculture_project_type",
    "depends_on": "eval:doc.agriculture_project_type"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Setup",
    "fieldname": "project_unit",
    "fieldtype": "Link",
    "label": "Planning UOM",
    "insert_after": "project_quantity",
    "options": "UOM",
    "mandatory_depends_on": "eval:doc.agriculture_project_type",
    "depends_on": "eval:doc.agriculture_project_type"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Setup",
    "fieldname": "initial_asset_cost",
    "fieldtype": "Currency",
    "label": "Legacy Opening Asset Value",
    "description": "Retained only for migration compatibility. Use the Opening Recognition section instead.",
    "insert_after": "project_unit",
    "hidden": 1,
    "read_only": 1
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Setup",
    "fieldname": "farm",
    "fieldtype": "Link",
    "label": "Farm",
    "insert_after": "initial_asset_cost",
    "options": "Farm",
    "mandatory_depends_on": "eval:doc.agriculture_project_type",
    "depends_on": "eval:doc.agriculture_project_type"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Setup",
    "fieldname": "section_break_opening_recognition",
    "fieldtype": "Section Break",
    "label": "Opening Livestock Recognition",
    "description": "Optional onboarding for animals already on hand. This prepares a draft opening entry for review; accounting is posted only when that entry is submitted.",
    "insert_after": "farm",
    "depends_on": "eval:doc.managed_item_doctype == 'Livestock Species'"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Setup",
    "fieldname": "create_opening_stock_entry",
    "fieldtype": "Check",
    "label": "Prepare Opening Animal Entry",
    "description": "Enable only when animals are already physically on hand at the start of this Project.",
    "insert_after": "section_break_opening_recognition",
    "default": "0",
    "depends_on": "eval:doc.managed_item_doctype == 'Livestock Species'"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Setup",
    "fieldname": "opening_quantity",
    "fieldtype": "Float",
    "label": "Opening Quantity",
    "description": "Actual animals physically on hand, not the planned carrying capacity.",
    "insert_after": "create_opening_stock_entry",
    "mandatory_depends_on": "eval:doc.create_opening_stock_entry",
    "depends_on": "eval:doc.managed_item_doctype == 'Livestock Species'"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Setup",
    "fieldname": "opening_unit_rate",
    "fieldtype": "Currency",
    "label": "Opening Value per Head / Bird",
    "description": "User-determined IAS 41 opening recognition value per animal.",
    "insert_after": "opening_quantity",
    "mandatory_depends_on": "eval:doc.create_opening_stock_entry",
    "depends_on": "eval:doc.managed_item_doctype == 'Livestock Species'"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Setup",
    "fieldname": "opening_recognition_date",
    "fieldtype": "Date",
    "label": "Opening Recognition Date",
    "insert_after": "opening_unit_rate",
    "default": "Today",
    "mandatory_depends_on": "eval:doc.create_opening_stock_entry",
    "depends_on": "eval:doc.managed_item_doctype == 'Livestock Species'"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Setup",
    "fieldname": "opening_stock_entry",
    "fieldtype": "Link",
    "label": "Opening Animal Entry",
    "insert_after": "opening_recognition_date",
    "options": "Animal Stock Entry",
    "read_only": 1,
    "depends_on": "eval:doc.managed_item_doctype == 'Livestock Species'"
  },
  {
    "doctype": "Custom Field",
    "dt": "Project",
    "module": "Farm Setup",
    "fieldname": "biological_asset",
    "fieldtype": "Link",
    "label": "Biological Asset",
    "insert_after": "opening_stock_entry",
    "options": "Biological Asset",
    "read_only": 1,
    "depends_on": "eval:doc.agriculture_project_type"
  }
]
