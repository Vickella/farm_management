{
  "doctype": "DocType",
  "name": "Farm Activity Type",
  "module": "Farm Calendar",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "is_submittable": 0,
  "editable_grid": 1,
  "engine": "InnoDB",
